<?xml version="1.0" encoding="utf-8"?>
<!--TODO: сделать для разных вьюшек свои стайлы-->
<resources>
    <style name="MaterialButtonStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">4dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextStyle">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ActionBarTitleStyle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ToolBarStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:background">@color/white</item>
        <item name="android:elevation">4dp</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.ActionBar</item>

        <item name="navigationIcon">@drawable/ic_arrow_back_24</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
        <item name="titleTextAppearance">@style/ActionBarTitleStyle</item>
    </style>
</resources>