<?xml version="1.0" encoding="utf-8"?>
<!--TODO: сделать для разных вьюшек свои стайлы-->
<resources>
    <style name="MaterialButtonStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">4dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextStyle">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ActionBarTitleStyle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ToolBarStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:background">@color/white</item>
        <item name="android:elevation">4dp</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.ActionBar</item>

        <item name="navigationIcon">@drawable/ic_arrow_back_24</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
        <item name="titleTextAppearance">@style/ActionBarTitleStyle</item>
    </style>

    <style name="BottomNavigationViewText" parent="TextStyle">
        <item name="android:textSize">@dimen/very_small_text</item>
    </style>

    <style name="BottomNavigationViewText.Active" parent="TextStyle">
        <item name="android:textSize">@dimen/very_small_text</item>
    </style>

    <style name="BottomNavigationView.Indicator">
        <item name="android:background">@color/white</item>
    </style>

    <style name="BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/BottomNavigationViewText.Active</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationViewText</item>
        <item name="itemIconTint">@color/bnv_icon_color</item>
        <item name="itemTextColor">@color/bnv_text_color</item>
        <item name="itemTextAppearanceActiveBoldEnabled">false</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNavigationView.Indicator</item>
    </style>

    <style name="TabLayoutText" parent="TextStyle">
        <item name="android:textSize">@dimen/small_text</item>
    </style>

    <style name="TabLayoutText.Selected" parent="TextStyle">
        <item name="android:textSize">@dimen/small_text</item>
    </style>

    <style name="TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@color/white</item>
        <item name="tabTextAppearance">@style/TabLayoutText</item>
        <item name="tabSelectedTextAppearance">@style/TabLayoutText.Selected</item>
        <item name="tabTextColor">@color/gray</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
    </style>
</resources>